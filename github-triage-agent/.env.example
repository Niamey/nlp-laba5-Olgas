# ── Обов'язкові (Gemini / Google AI, langchain-google-genai) ─────
# Достатньо одного з двох (пріоритет: GOOGLE_API_KEY, потім GEMINI_API_KEY)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ── GitHub (без токена — unauthenticated, 60 req/hour) ──────────
GITHUB_TOKEN=ghp_...

# ── Моделі (Gemini) ───────────────────────────────────────────────
PRIMARY_MODEL=gemini-2.5-flash
# Для нових ключів gemini-2.0-flash може повертати 404 — краще збіг з PRIMARY або свіжий ID з AI Studio.
SECONDARY_MODEL=gemini-2.5-flash

# ── LangSmith (опціонально; без валідного ключа буде 403 у логах) ─
# Ключ: https://smith.langchain.com → Settings → API Keys
# Увімкнути трасування: LANGCHAIN_TRACING_V2=true і реальний LANGCHAIN_API_KEY
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=github-triage-agent

# ── MCP (опціонально) ───────────────────────────────────────────
# Другий MCP (third-party). Якщо не налаштуєш — закоментуй обидві змінні:
# агент працюватиме лише через github_triage + fetch_url.
#
# Варіант A — рекомендовано: той самий Python, що й main.py (без ручного шляху).
# Потрібен: pip install mcp-server-fetch (у requirements.txt).
FETCH_MCP_COMMAND=AUTO
FETCH_MCP_ARGS=-m mcp_server_fetch
#
# Варіант B — Astral uv у PATH (якщо є uvx):
# FETCH_MCP_COMMAND=uvx
# FETCH_MCP_ARGS=mcp-server-fetch
#
# Варіант C — явний шлях до python.exe з .venv (Windows):
# FETCH_MCP_COMMAND=C:\path\to\project\.venv\Scripts\python.exe
# FETCH_MCP_ARGS=-m mcp_server_fetch

# ── Ліміти ──────────────────────────────────────────────────────
MAX_TOOL_CALLS=25
MAX_LOOPS=3

# ── Кеш (опціонально; без CACHE_DIR — системний temp + triage_cache) ─
# Windows: set CACHE_DIR=D:\data\triage_cache
CACHE_DIR=
CACHE_TTL_SECONDS=21600
